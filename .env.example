# Example ONLY: never use these placeholders for a running agent.
# Generate real private values using: agent-lumos init
LUMOS_HOST=127.0.0.1
LUMOS_PORT=8765
LUMOS_USERNAME=admin
LUMOS_AGENT_ID=lumos-local
LUMOS_JWT_SECRET=REPLACE_WITH_48_BYTES_OF_RANDOM_SECRET
LUMOS_ADMIN_PASSWORD_HASH=REPLACE_WITH_PBKDF2_SHA256_HASH
LUMOS_SEND_INTERVAL=15
# Optional: https://your-collector.example/v1/report (or http://127.0.0.1:8766/v1/report for demo)
LUMOS_TELEMETRY_URL=
LUMOS_TELEMETRY_TOKEN=REPLACE_WITH_RANDOM_TOKEN
LUMOS_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
LUMOS_LOG_FILE=agent_lumos.log
# Required if LUMOS_HOST is not a loopback address:
# LUMOS_TLS_CERT=/path/to/cert.pem
# LUMOS_TLS_KEY=/path/to/key.pem

# Optional: enable read-only STM32 telemetry inside the Agent Lumos API
# LUMOS_STM32_PORT=/dev/ttyACM0
LUMOS_STM32_BAUD=115200
